# Copy to .env.local for local dev. In GitHub, set these as repo Variables
# (Settings > Secrets and variables > Actions > Variables).
NEXT_PUBLIC_SITE_URL=https://YOUR-USER.github.io/my-house-listing
# Google Ads tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label from Google Ads > Goals > Conversions, e.g. AbCdEfGhIjK
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
